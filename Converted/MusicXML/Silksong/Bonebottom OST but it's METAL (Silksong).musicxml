  <credit page="1">
    <credit-type>subtitle</credit-type>
    <credit-words default-x="616.9347" default-y="1467.696651" justify="center" valign="top" font-size="9">I don't know why I keep including this message about how I obviously didn't write the music I'm transcribing.
</credit-words>
    <credit-words>It's kind of pointless. I did it with the first thing I transcribed and then just kept going.
</credit-words>
    <credit-words>Anyway, I did not compose this.</credit-words>
    </credit>
