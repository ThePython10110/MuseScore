          <style>title</style>
          <text>Elevator (The Stanley Parable) - Bensound</text>
          </Text>
        <Text>
          <eid>Nv5/Qui1gMH_/jRXrB+2FO</eid>
          <style>subtitle</style>
          <text><font size="10"></font>Original by Bensound called &quot;The Elevator Bossa Nova.&quot;
<font size="16"></font>I did not write this.</text>
          </Text>
        <Text>
          <eid>dcARjzH0IHG_QP2Q9Ii9Wm</eid>
          <style>composer</style>
          <text>Bensound</text>
          </Text>
        <Text>
          <eid>0yOvEKxu3H_F7XMeS1ToRD</eid>
