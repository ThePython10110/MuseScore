        <Text>
          <eid>ddWHs+vaJuO_b77RmRw9FVG</eid>
          <style>title</style>
          <text>Leo's Fortune - Traps and Thorns</text>
          </Text>
        <Text>
          <eid>/bzbXDq7krO_1kykkmInb1L</eid>
          <style>subtitle</style>
          <text>I did not compose this!</text>
          </Text>
        <Text>
          <eid>8ACZZ2WfF7F_GAkqXhghyU</eid>
          <style>composer</style>
          <text>Leif Jonsson</text>
          </Text>
