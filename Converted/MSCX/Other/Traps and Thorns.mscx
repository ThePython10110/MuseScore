      <Measure>
        <eid>SsqxyMnmuSP_YXqBtuHtYTL</eid>
        <stretch>0.4</stretch>
        <voice>
          <KeySig>
            <eid>v+jLAKwwOLD_ugkWL2CwWZB</eid>
            <concertKey>4</concertKey>
            </KeySig>
          <TimeSig>
            <eid>Y5zzuJLLEYB_gpAcDcIAkQC</eid>
            <sigN>3</sigN>
            <sigD>4</sigD>
            </TimeSig>
          <Tempo>
            <tempo>2</tempo>
            <followText>1</followText>
